  <build>
    <plugins>
      <plugin>
        <artifactId>maven-ear-plugin</artifactId>
        <!-- explicit execution to prevent "The packaging plugin for this project did not assign a main file to the project but it has attachments." -->
        <executions>
          <execution>
            <goals>
              <goal>ear</goal>
            </goals>
            <configuration>
              <classifier>${classifier}</classifier>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <version>7</version>
          <defaultLibBundleDir>lib</defaultLibBundleDir>
          <applicationName>curalink</applicationName>
          <displayName>dcm4chee-arc</displayName>
          <earSourceDirectory>${earSourceDirectory}</earSourceDirectory>
          <workDirectory>${project.build.directory}/${project.build.finalName}-${classifier}</workDirectory>
          <outputFileNameMapping>@{artifactId}@-@{version}@@{dashClassifier?}@.@{extension}@</outputFileNameMapping>
          <filtering>true</filtering>
          <modules>
            <webModule>
              <groupId>org.curalink.curalink-arc</groupId>
              <artifactId>curalink-arc-retrieve-xdsi</artifactId>
              <contextRoot>curalink/xdsi</contextRoot>
            </webModule>
            <webModule>
              <groupId>org.curalink.curalink-arc</groupId>
              <artifactId>curalink-arc-war</artifactId>
              <contextRoot>curalink</contextRoot>
            </webModule>
            <webModule>
              <groupId>org.curalink.curalink-arc</groupId>
              <artifactId>curalink-arc-ui2</artifactId>
              <contextRoot>curalink/ui2</contextRoot>
            </webModule>
            <webModule>
              <groupId>org.curalink.curalink-arc</groupId>
              <artifactId>curalink-arc-xsl-cda</artifactId>
              <contextRoot>curalink/xsl</contextRoot>
            </webModule>
            <webModule>
              <groupId>org.curalink.curalink-arc</groupId>
              <artifactId>curalink-arc-proxy</artifactId>
              <contextRoot>curalink-proxy</contextRoot>
            </webModule>
          </modules>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>unsecure</id>
      <activation>
        <property>
          <name>secure</name>
          <value>!all</value>
        </property>
      </activation>
      <properties>
        <webXml>${project.basedir}/src/main/webapp/WEB-INF/web.xml</webXml>
        <classifier>${db}</classifier>
        <dcm4chee-arc-war-classifier>unsecure</dcm4chee-arc-war-classifier>
        <dcm4chee-arc-proxy-classifier>unsecure</dcm4chee-arc-proxy-classifier>
      </properties>
    </profile>
    <profile>
      <id>secure</id>
      <activation>
        <property>
          <name>secure</name>
          <value>all</value>
        </property>
      </activation>
      <properties>
        <webXml>${project.basedir}/src/main/webapp/WEB-INF/web-secure.xml</webXml>
        <classifier>${db}-secure</classifier>
        <dcm4chee-arc-war-classifier>secure</dcm4chee-arc-war-classifier>
        <dcm4chee-arc-proxy-classifier>secure</dcm4chee-arc-proxy-classifier>
      </properties>
